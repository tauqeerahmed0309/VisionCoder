# Copy this file to .env. Never commit .env or real API keys.

# Start with MOCK_MODEL=true to test FastAPI without using an API key.
# Set MOCK_MODEL=false after you add a valid Gemini API key.
MOCK_MODEL=true
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Comma-separated frontend origins allowed to call this backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:4173,http://127.0.0.1:4173
MAX_IMAGE_MB=8
MODEL_TIMEOUT_SECONDS=60

# --- Reliability (all optional; these are the defaults) ---
# Whole-request budget in seconds, including retries. Keep below the frontend's 150 s.
TOTAL_TIMEOUT_SECONDS=110
# Simultaneous Gemini calls; extra requests wait up to QUEUE_TIMEOUT_SECONDS, then get a 503 "BUSY".
MAX_CONCURRENT_REQUESTS=3
QUEUE_TIMEOUT_SECONDS=20
# Requests per minute per client IP (0 = off).
RATE_LIMIT_PER_MINUTE=20
# Finished pages kept so repeats cost no quota (0 = off).
CACHE_SIZE=32
CACHE_TTL_SECONDS=600
# After this many consecutive provider failures, pause calls for the cooldown instead of making users wait.
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=30
# Larger sketches are downscaled to this many pixels on the longest side before upload.
MAX_IMAGE_DIMENSION=1600
